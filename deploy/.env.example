# Domain
DOMAIN=naviq.uz
APP_DOMAIN=app.naviq.uz
API_DOMAIN=api.naviq.uz
ACME_EMAIL=admin@naviq.uz

# Frontend
NEXT_PUBLIC_API_URL=https://api.naviq.uz/api/v1
VITE_FRONTEND_APP_URL=https://app.naviq.uz

# Database
POSTGRES_DB=naviq
POSTGRES_USER=naviq
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend DB URLs
DATABASE_URL=postgresql+asyncpg://naviq:CHANGE_ME_STRONG_PASSWORD@postgres:5432/naviq
DATABASE_URL_SYNC=postgresql://naviq:CHANGE_ME_STRONG_PASSWORD@postgres:5432/naviq

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# App
APP_ENV=production
CORS_ORIGINS=["https://naviq.uz","https://www.naviq.uz","https://app.naviq.uz"]

# Security
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI
OPENAI_API_KEY=

# Optional
SENTRY_DSN=
SEED_ON_BOOT=0
