# API Configuration
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth
# Получите Client ID в Google Cloud Console: https://console.cloud.google.com/
# 1. Создайте проект или выберите существующий
# 2. Включите Google+ API
# 3. Создайте OAuth 2.0 Client ID
# 4. Добавьте Authorized JavaScript origins: http://localhost:3000, http://localhost:5173
# 5. Добавьте Authorized redirect URIs: http://localhost:3000, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
