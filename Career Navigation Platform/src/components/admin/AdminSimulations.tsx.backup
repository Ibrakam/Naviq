import { useEffect, useState } from 'react';
import { Plus, Layers, Edit, Trash2, Clock, Users, BarChart } from 'lucide-react';
import { Card } from '../ui/card';
import { Button } from '../ui/button';
import { Input } from '../ui/input';
import { Label } from '../ui/label';
import { Textarea } from '../ui/textarea';

interface AdminSimulationsProps {
  accessToken: string;
}

interface Simulation {
  id: number;
  title: string;
  description: string;
  company: string;
  track_id: number;
  duration: string;
  level: string;
  is_active: boolean;
  steps: any[];
}

export function AdminSimulations({ accessToken }: AdminSimulationsProps) {
  const [simulations, setSimulations] = useState<Simulation[]>([]);
  const [loading, setLoading] = useState(true);
  const [showCreateForm, setShowCreateForm] = useState(false);
  const [newSimulation, setNewSimulation] = useState({
    title: '',
    description: '',
    company: '',
    track_id: 1,
    duration: '2-3 hours',
    level: 'beginner',
  });

  useEffect(() => {
    loadSimulations();
  }, []);

  const loadSimulations = async () => {
    try {
      const response = await fetch('http://localhost:8000/api/admin/simulations', {
        headers: {
          Authorization: `Bearer ${accessToken}`,
        },
      });

      if (response.ok) {
        const data = await response.json();
        setSimulations(data);
      }
    } catch (error) {
      console.error('Failed to load simulations:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleCreateSimulation = async (e: React.FormEvent) => {
    e.preventDefault();

    try {
      const response = await fetch('http://localhost:8000/api/admin/simulations', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${accessToken}`,
        },
        body: JSON.stringify({
          ...newSimulation,
          steps: [
            {
              title: 'Introduction',
              description: 'Get familiar with the task',
              type: 'theory',
            },
            {
              title: 'Practice',
              description: 'Complete the exercise',
              type: 'practice',
            },
            {
              title: 'Review',
              description: 'Review your solution',
              type: 'review',
            },
          ],
        }),
      });

      if (response.ok) {
        alert('Simulation created successfully!');
        setShowCreateForm(false);
        loadSimulations();
        setNewSimulation({
          title: '',
          description: '',
          company: '',
          track_id: 1,
          duration: '2-3 hours',
          level: 'beginner',
        });
      } else {
        alert('Failed to create simulation');
      }
    } catch (error) {
      console.error('Failed to create simulation:', error);
      alert('Error creating simulation');
    }
  };

  const getLevelColor = (level: string) => {
    switch (level) {
      case 'beginner':
        return 'from-green-500 to-green-600';
      case 'intermediate':
        return 'from-blue-500 to-blue-600';
      case 'advanced':
        return 'from-purple-500 to-purple-600';
      default:
        return 'from-gray-500 to-gray-600';
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[400px]">
        <div className="text-center">
          <Layers className="w-12 h-12 text-purple-500 animate-pulse mx-auto mb-4" />
          <p className="text-gray-400">Loading simulations...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-2xl font-bold text-white">Simulation Management</h2>
          <p className="text-gray-400 mt-1">Create and manage career simulations</p>
        </div>
        <Button
          onClick={() => setShowCreateForm(!showCreateForm)}
          className="bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700"
        >
          <Plus className="w-4 h-4 mr-2" />
          Create Simulation
        </Button>
      </div>

      {/* Create Form */}
      {showCreateForm && (
        <Card className="bg-[#0f1529] border-gray-800 p-6">
          <h3 className="text-xl font-bold text-white mb-6">Create New Simulation</h3>
          <form onSubmit={handleCreateSimulation} className="space-y-4">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <Label className="text-gray-300">Simulation Title</Label>
                <Input
                  type="text"
                  value={newSimulation.title}
                  onChange={(e) => setNewSimulation({ ...newSimulation, title: e.target.value })}
                  placeholder="e.g., Build a REST API"
                  className="bg-[#0a0f1e] border-gray-700 text-white"
                  required
                />
              </div>

              <div>
                <Label className="text-gray-300">Company</Label>
                <Input
                  type="text"
                  value={newSimulation.company}
                  onChange={(e) => setNewSimulation({ ...newSimulation, company: e.target.value })}
                  placeholder="e.g., TechCorp"
                  className="bg-[#0a0f1e] border-gray-700 text-white"
                  required
                />
              </div>

              <div>
                <Label className="text-gray-300">Track ID</Label>
                <Input
                  type="number"
                  value={newSimulation.track_id}
                  onChange={(e) => setNewSimulation({ ...newSimulation, track_id: parseInt(e.target.value) })}
                  className="bg-[#0a0f1e] border-gray-700 text-white"
                  required
                />
              </div>

              <div>
                <Label className="text-gray-300">Duration</Label>
                <Input
                  type="text"
                  value={newSimulation.duration}
                  onChange={(e) => setNewSimulation({ ...newSimulation, duration: e.target.value })}
                  placeholder="e.g., 2-3 hours"
                  className="bg-[#0a0f1e] border-gray-700 text-white"
                  required
                />
              </div>

              <div>
                <Label className="text-gray-300">Level</Label>
                <select
                  value={newSimulation.level}
                  onChange={(e) => setNewSimulation({ ...newSimulation, level: e.target.value })}
                  className="w-full px-3 py-2 bg-[#0a0f1e] border border-gray-700 rounded-md text-white"
                >
                  <option value="beginner">Beginner</option>
                  <option value="intermediate">Intermediate</option>
                  <option value="advanced">Advanced</option>
                </select>
              </div>
            </div>

            <div>
              <Label className="text-gray-300">Description</Label>
              <Textarea
                value={newSimulation.description}
                onChange={(e) => setNewSimulation({ ...newSimulation, description: e.target.value })}
                placeholder="Brief description of the simulation..."
                className="bg-[#0a0f1e] border-gray-700 text-white"
                rows={3}
                required
              />
            </div>

            <div className="flex gap-3">
              <Button
                type="button"
                variant="outline"
                onClick={() => setShowCreateForm(false)}
                className="border-gray-700 text-gray-400 hover:text-white"
              >
                Cancel
              </Button>
              <Button
                type="submit"
                className="bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700"
              >
                Create Simulation
              </Button>
            </div>
          </form>
        </Card>
      )}

      {/* Stats */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card className="bg-[#0f1529] border-gray-800 p-6">
          <div className="flex items-center justify-between mb-2">
            <span className="text-gray-400 text-sm">Total Simulations</span>
            <Layers className="w-5 h-5 text-purple-500" />
          </div>
          <p className="text-3xl font-bold text-white">{simulations.length}</p>
        </Card>

        <Card className="bg-[#0f1529] border-gray-800 p-6">
          <div className="flex items-center justify-between mb-2">
            <span className="text-gray-400 text-sm">Active Simulations</span>
            <BarChart className="w-5 h-5 text-green-500" />
          </div>
          <p className="text-3xl font-bold text-white">
            {simulations.filter((s) => s.is_active).length}
          </p>
        </Card>

        <Card className="bg-[#0f1529] border-gray-800 p-6">
          <div className="flex items-center justify-between mb-2">
            <span className="text-gray-400 text-sm">Total Steps</span>
            <Clock className="w-5 h-5 text-blue-500" />
          </div>
          <p className="text-3xl font-bold text-white">
            {simulations.reduce((sum, s) => sum + (s.steps?.length || 0), 0)}
          </p>
        </Card>
      </div>

      {/* Simulations List */}
      <div className="space-y-4">
        {simulations.length > 0 ? (
          simulations.map((simulation) => (
            <Card
              key={simulation.id}
              className="bg-[#0f1529] border-gray-800 p-6 hover:border-purple-600 transition-all"
            >
              <div className="flex items-start justify-between">
                <div className="flex items-start gap-4 flex-1">
                  {/* Icon */}
                  <div className={`w-12 h-12 rounded-lg bg-gradient-to-br ${getLevelColor(simulation.level)} flex items-center justify-center flex-shrink-0`}>
                    <Layers className="w-6 h-6 text-white" />
                  </div>

                  {/* Simulation Info */}
                  <div className="flex-1">
                    <div className="flex items-center gap-3 mb-2">
                      <h3 className="text-lg font-bold text-white">{simulation.title}</h3>
                      <span className="px-2 py-1 text-xs font-medium bg-blue-600 text-white rounded-full">
                        {simulation.company}
                      </span>
                      <span className={`px-2 py-1 text-xs font-medium bg-gradient-to-r ${getLevelColor(simulation.level)} text-white rounded-full capitalize`}>
                        {simulation.level}
                      </span>
                      {simulation.is_active && (
                        <span className="px-2 py-1 text-xs font-medium bg-green-600 text-white rounded-full">
                          Active
                        </span>
                      )}
                    </div>

                    <p className="text-gray-400 text-sm mb-3">{simulation.description}</p>

                    <div className="flex items-center gap-6 text-gray-500 text-sm">
                      <div className="flex items-center gap-2">
                        <Clock className="w-4 h-4" />
                        <span>{simulation.duration}</span>
                      </div>
                      <div className="flex items-center gap-2">
                        <Layers className="w-4 h-4" />
                        <span>{simulation.steps?.length || 0} steps</span>
                      </div>
                      <div className="flex items-center gap-2">
                        <Users className="w-4 h-4" />
                        <span>Track #{simulation.track_id}</span>
                      </div>
                    </div>
                  </div>
                </div>

                {/* Actions */}
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    className="border-gray-700 text-gray-400 hover:text-white hover:border-blue-600"
                  >
                    <Edit className="w-4 h-4" />
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    className="border-gray-700 text-gray-400 hover:text-white hover:border-red-600"
                  >
                    <Trash2 className="w-4 h-4" />
                  </Button>
                </div>
              </div>
            </Card>
          ))
        ) : (
          <Card className="bg-[#0f1529] border-gray-800 p-12">
            <div className="text-center">
              <Layers className="w-16 h-16 text-gray-600 mx-auto mb-4" />
              <p className="text-gray-400 text-lg">No simulations found</p>
              <p className="text-gray-500 text-sm mt-2">Create your first simulation to get started</p>
            </div>
          </Card>
        )}
      </div>
    </div>
  );
}
