FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_FRONTEND_APP_URL=https://app.naviq.uz
ENV VITE_FRONTEND_APP_URL=${VITE_FRONTEND_APP_URL}

COPY package*.json ./
RUN npm ci

COPY index.html ./
COPY postcss.config.mjs ./
COPY vite.config.ts ./
COPY src ./src

RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
  listen 4173;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
  }
}
EOF

EXPOSE 4173

CMD ["nginx", "-g", "daemon off;"]
